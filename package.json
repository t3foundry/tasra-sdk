    "docs/getting-started.md",
    "docs/glossary.md",
    "docs/installation.md",
    "docs/manage-slot.md",
    "docs/native-approvals.md",
    "docs/prerequisites.md",
    "docs/read-slot.md",
    "docs/reference/README.md",
    "docs/reference/app-node.md",
    "docs/reference/app.md",
    "docs/reference/chain-node.md",
    "docs/reference/chain.md",
    "docs/reference/committee.md",
    "docs/reference/main.md",
    "docs/reference/oid4vp.md",
    "docs/reference/verifier-agent.md",
    "docs/shared-account.md",
    "docs/signing-and-encryption.md",
    "docs/signing.md",
    "examples/committee-slot.ts",
    "examples/connect-fuji.ts",
    "examples/connect-network.ts",
    "examples/credential-approvals.ts",
    "examples/document-signing.ts",
    "examples/document-signing/README.md",
    "examples/document-signing/backend.ts",
    "examples/document-signing/build.mjs",
    "examples/document-signing/config.ts",
    "examples/document-signing/gitignore.template",
    "examples/document-signing/model.ts",
    "examples/document-signing/network.ts",
    "examples/document-signing/package.json",
    "examples/document-signing/public/index.html",
    "examples/document-signing/public/sample.pdf",
    "examples/document-signing/public/styles.css",
    "examples/document-signing/server.ts",
    "examples/document-signing/setup.ts",
    "examples/document-signing/store.ts",
    "examples/document-signing/tsconfig.json",
    "examples/document-signing/verify.ts",
    "examples/document-signing/web/app.ts",
    "examples/document-signing/web/preview.ts",
    "examples/document-signing/web/wallet.ts",
    "examples/document-signing/workflow.test.ts",
    "examples/document-signing/workflow.ts",
    "examples/encrypted-notes.ts",
    "examples/ethers-signer.ts",
    "examples/fund-slot.ts",
    "examples/getting-started.ts",
    "examples/learning-authorize.ts",
    "examples/learning-cancel-slot.ts",
    "examples/learning-context.ts",
    "examples/learning-create-slot.ts",
    "examples/learning-read-slot.ts",
    "examples/learning-renew-slot.ts",
    "examples/learning-sign.ts",
    "examples/live-config.ts",
    "examples/minimal.ts",
    "examples/native-approvals.ts",
    "examples/network.ts",
    "examples/offline.ts",
    "examples/personal-vault.ts",
    "examples/provision-slot.ts",
    "examples/shared-account.ts",
    "examples/slot-address.ts",
    "examples/slot-creation.ts",
    "examples/tutorial-negative.ts",
    "examples/tutorial-support.ts",
    "examples/viem-account.ts",
    "skills/README.md",
    "skills/tasra-chain/SKILL.md",
    "skills/tasra-chain/references/advanced.md",
    "skills/tasra-committee-path/SKILL.md",
    "skills/tasra-committee-path/references/advanced.md",
    "skills/tasra-create-slot/SKILL.md",
    "skills/tasra-create-slot/references/advanced.md",
    "skills/tasra-credentials-and-sessions/SKILL.md",
    "skills/tasra-credentials-and-sessions/references/advanced.md",
    "skills/tasra-dcql-rules/SKILL.md",
    "skills/tasra-dcql-rules/references/advanced.md",
    "skills/tasra-getting-started/SKILL.md",
    "skills/tasra-handle-errors/SKILL.md",
    "skills/tasra-handle-errors/references/advanced.md",
    "skills/tasra-hovi-issuer/SKILL.md",
    "skills/tasra-hovi-issuer/references/advanced.md",
    "skills/tasra-ibe-identity-scoped/SKILL.md",
    "skills/tasra-ibe-identity-scoped/references/advanced.md",
    "skills/tasra-oid4vp-wallet-and-verifier-agent/SKILL.md",
    "skills/tasra-oid4vp-wallet-and-verifier-agent/references/advanced.md",
    "skills/tasra-sign-and-decrypt/SKILL.md",
    "skills/tasra-sign-and-decrypt/references/advanced.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "example:getting-started": "tsx examples/getting-started.ts",
    "example:minimal": "tsx examples/minimal.ts",
    "example:ethers": "tsx examples/ethers-signer.ts",
    "example:viem": "tsx examples/viem-account.ts",
    "example:committee-slot": "tsx examples/committee-slot.ts",
    "test:e2e": "tsx test/e2e/preflight.ts && tsx test/e2e/keys-public.ts && tsx test/e2e/encrypt-roundtrip.ts && tsx test/e2e/access-dcql.ts && tsx test/e2e/threshold-kofn.ts && tsx test/e2e/client-sovereign.ts",
    "test:holder-binding": "tsx test/e2e/holder-binding.ts",
    "test:slot-client": "tsx test/e2e/slot-client-verifier.ts",
    "test:reconcile": "tsx test/reconcile/nodes.ts && tsx test/reconcile/slots.ts && tsx test/reconcile/sets.ts && tsx test/reconcile/tasra.ts && tsx test/reconcile/overview.ts",
    "test:slashing": "tsx test/slashing/history.ts",
    "test:destructive": "KK_DESTRUCTIVE=1 tsx test/slashing/node-slash-lifecycle.ts && KK_DESTRUCTIVE=1 tsx test/slashing/verifier-misissue-slash.ts && tsx test/slashing/governance-slash.ts",
    "test:fleet": "npm run test:e2e && npm run test:reconcile && npm run test:slashing",
    "test:prod": "tsx test/e2e/observability.ts && tsx test/e2e/credentials-prod.ts && tsx test/e2e/renewal-revocation.ts && tsx test/e2e/sign-roundtrip.ts && tsx test/e2e/decrypt-server.ts && tsx test/e2e/committee-authorize.ts && tsx test/e2e/audit-metering.ts && tsx test/e2e/slot-lifecycle.ts && tsx test/e2e/governance.ts && tsx test/economics/curve.ts",
    "stress:crypto": "tsx test/stress/crypto-throughput.ts",
    "stress:keyops": "tsx test/stress/keyops.ts",
    "stress:keyops:committees": "tsx test/stress/keyops-committees.ts",
    "stress": "npm run stress:crypto && npm run stress:keyops && npm run stress:keyops:committees",
    "clean": "rm -rf dist",
    "ci": "npm run verify",
    "verify:pkg": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm && tsx test/pack-smoke.ts",
    "prepare": "npm run build && node scripts/install-hooks.mjs",
    "prepublishOnly": "npm run ci",
    "verify:consumers": "tsx test/consumers.ts",
    "test:acceptance": "tsx test/live/acceptance.ts",
    "example:provision": "tsx examples/provision-slot.ts",
    "example:personal-vault": "tsx examples/personal-vault.ts",
    "verify:all": "tsx test/verify/run.ts",
    "verify:bootstrap": "tsx test/verify/bootstrap.ts",
    "stress:slots:onchain": "tsx test/stress/create-slots-onchain.ts",
    "stress:slots:onchain:parallel": "tsx test/stress/create-slots-onchain-parallel.ts",
    "test:docs:live": "npm run build && node --import tsx test/docs-live.ts",
    "docs:reference": "node --import tsx test/docs-reference.ts",
    "verify:docs": "node --import tsx test/docs-reference.ts --check && node --import tsx test/docs-check.ts",
    "test:tutorials:live": "npm run build && node test/tutorials-live.mjs",
    "docs:build": "npm run build --prefix site",
    "verify:document-app": "node test/document-app-check.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:infrastructure": "node --test scripts/verify-infrastructure.test.mjs scripts/git-hooks.test.mjs scripts/api-surface.test.mjs scripts/api-changes.test.mjs scripts/quality.test.mjs scripts/performance.test.mjs scripts/publication.test.mjs scripts/release-tag.test.mjs",
    "verify:repository": "node scripts/verify-repository.mjs && npm run api:changes",
    "verify:security": "npm audit --include=dev --include=optional --include=peer --audit-level=high && npm audit --prefix site --include=dev --include=optional --audit-level=high && npm audit signatures",
    "verify:site": "npm ci --prefix site && npm run docs:build",
    "api:changes": "node scripts/api-changes.mjs",
    "quality": "node scripts/quality.mjs",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:mutation": "stryker run stryker.config.mjs",
    "performance": "node scripts/performance.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t3-foundry/tasra-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/t3-foundry/tasra-sdk/issues"
  },
  "homepage": "https://github.com/t3-foundry/tasra-sdk#readme",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "ethers": "^6.13.0",
    "fast-check": "4.10.2",
    "next": "^16.3.8",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "webpack": "^5.111.1",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "keykeeper",
