{
  "name": "tasra-sdk",
  "version": "0.2.4",
  "description": "TypeScript SDK for Tasra network slots, credential-based access, distributed encryption and signing, and on-chain operations.",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "chain": [
        "./dist/chain/index.d.ts"
      ],
      "committee": [
        "./dist/committee/index.d.ts"
      ],
      "oid4vp": [
        "./dist/oid4vp/index.d.ts"
      ],
      "verifier-agent": [
        "./dist/verifier-agent/index.d.ts"
      ],
      "chain/node": [
        "./dist/chain/node.d.ts"
      ],
      "app": [
        "./dist/app/index.d.ts"
      ],
      "app/node": [
        "./dist/app/node.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chain": {
      "types": "./dist/chain/index.d.ts",
      "import": "./dist/chain/index.js",
      "default": "./dist/chain/index.js"
    },
    "./committee": {
      "types": "./dist/committee/index.d.ts",
      "import": "./dist/committee/index.js",
      "default": "./dist/committee/index.js"
    },
    "./oid4vp": {
      "types": "./dist/oid4vp/index.d.ts",
      "import": "./dist/oid4vp/index.js",
      "default": "./dist/oid4vp/index.js"
    },
    "./verifier-agent": {
      "types": "./dist/verifier-agent/index.d.ts",
      "import": "./dist/verifier-agent/index.js",
      "default": "./dist/verifier-agent/index.js"
    },
    "./package.json": "./package.json",
    "./chain/node": {
      "types": "./dist/chain/node.d.ts",
      "import": "./dist/chain/node.js",
      "default": "./dist/chain/node.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js",
      "default": "./dist/app/index.js"
    },
    "./app/node": {
      "types": "./dist/app/node.d.ts",
      "import": "./dist/app/node.js",
      "default": "./dist/app/node.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "docs/DEVELOPER-EXPERIENCE.md",
    "docs/README.md",
    "docs/access-control.md",
    "docs/ai-development.md",
