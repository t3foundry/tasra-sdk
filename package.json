    "docs/application-api.md",
    "docs/architecture.md",
    "docs/basics.md",
    "docs/capabilities.md",
    "docs/chain.md",
    "docs/compatibility.md",
    "docs/consumer-migrations.md",
    "docs/create-slot.md",
    "docs/document-signing.md",
